{
  "name": "anlly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "build": "npm run build:function && npm run typecheck && vite build && npm run build:server",
    "build:function": "npm run db:generate && esbuild server/vercel.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=api/index.js --log-level=warning",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.js --log-level=warning",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts || (sleep 2 && prisma migrate dev --config prisma7.config.ts)",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts || (sleep 2 && prisma migrate deploy --config prisma7.config.ts)",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "hono": "^4.13.13",
    "lucide-react": "^0.544.0",
    "nodemailer": "^10.1.7",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.7",
    "esbuild": "^0.28.2",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
