# Cópia para .env — nunca versione o .env real
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/app"
# ≥ 32 caracteres (openssl rand -base64 32)
AUTH_SECRET=""
# URL pública do app (em dev, o Vite; em prod, a URL do servidor)
APP_URL="http://localhost:5173"

PORT=3000
NODE_ENV="development"

# SMTP para recuperação de senha (opcional — se ausente, "Esqueci a senha" retorna erro)
# SMTP_HOST="smtp.seuprovedor.com"
# SMTP_PORT=587
# SMTP_USER="usuario"
# SMTP_PASS="senha"
# SMTP_FROM="Anlly <nao-responda@seu-dominio.com>"
